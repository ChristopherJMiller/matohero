#!/usr/bin/env bash
# Run BIONICLE Heroes under Wine from a working copy of the installed game.
#   tools/rungame setup                 copy orig/game to run/game and finish the install
#                                       (nuconfig.txt, Ogg2Wav music conversion)
#   tools/rungame [--headless[=SECS]] [--keys "T:KEY ..."] [--mute|--sound] [--exe PATH]
#                 [-- game args]
#                                       run the game; --headless runs it in Xvfb for SECS
#                                       seconds (default 40), saving a screenshot every 5 s
#                                       to run/shots/; --keys presses xdotool KEYs at those
#                                       times, e.g. --keys "15:Escape 25:Return".
#                                       Headless runs are muted unless --sound is given;
#                                       --mute mutes a windowed run too.
# The Wine prefix is run/prefix, separate from the compiler's toolchain/wineprefix.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
game="$root/run/game"
export WINEPREFIX="$root/run/prefix"
export WINEDEBUG="${WINEDEBUG:--all}"
export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:-mscoree,mshtml=}"

# Muting: the game plays into a throwaway PipeWire null sink (PULSE_SINK), so its sound
# code runs as usual but nothing reaches the speakers; the sink is removed on exit.
# Without pw-cli, Wine gets no sound server at all (no audio device).
mute_node=""
mute() {
    local name="bionicle-mute-$$"
    if command -v pw-cli >/dev/null 2>&1 && pw-cli create-node adapter "{ factory.name=support.null-audio-sink node.name=$name node.description=\"BIONICLE (muted)\" media.class=Audio/Sink object.linger=true priority.session=1 priority.driver=1 audio.position=[ FL FR ] }" >/dev/null 2>&1; then
        mute_node="$(pw-cli ls Node 2>/dev/null | awk -v n="\"$name\"" '/^[[:space:]]*id [0-9]+,/ {gsub(",", "", $2); id = $2} $1 == "node.name" && $3 == n {print id}')"
        export PULSE_SINK="$name"
        trap unmute EXIT
    else
        export PULSE_SERVER="unix:/nonexistent"
    fi
}
unmute() {
    if [[ -n "$mute_node" ]]; then
        pw-cli destroy "$mute_node" >/dev/null 2>&1 || true
        mute_node=""
    fi
}

setup() {
    [[ -d "$root/orig/game" ]] || { echo "orig/game missing; run tools/extract_orig.py" >&2; exit 1; }
    mkdir -p "$root/run"
    rm -rf "$game"
    cp -r "$root/orig/game" "$game"
    if [[ -f "$root/orig/nuconfig.txt" ]]; then
        cp "$root/orig/nuconfig.txt" "$game/nuconfig.txt"
    fi
    # The InstallShield script decodes the music at install time:
    # Ogg2Wav.exe walks a folder and runs oggdec.exe on each *.ogg.
    # Flags as the installer would need them: recurse into _Music/_Cutscenes, no UI.
    # Output is <name>_l.wgt/<name>_r.wgt next to each source (originals deleted).
    (cd "$game/Audio" && wine Ogg2Wav.exe /recursive /quiet "$(winepath -w "$game/Audio")")
    wineserver -w
    echo "run/game ready: $(find "$game/Audio" -iname "*.wgt" | wc -l) .wgt files, $(find "$game/Audio" -iname "*.ogg" | wc -l) .ogg left"
}

run() {
    local headless="" exe="$game/Bionicle.exe" keys="" sound=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --headless) headless=40 ;;
            --headless=*) headless="${1#*=}" ;;
            --exe) exe="$(realpath "$2")"; shift ;;
            --keys) keys="$2"; shift ;;
            --mute) sound=off ;;
            --sound) sound=on ;;
            --) shift; break ;;
            *) break ;;
        esac
        shift
    done
    [[ -d "$game" ]] || setup
    cd "$game"
    # The hook DLL (tools/hook.py --install) stands in for xinput1_1; Wine must prefer it
    # over its builtin. Remove run/game/xinput1_1.dll to run the original unmodified.
    if [[ -f "$game/xinput1_1.dll" ]]; then
        export WINEDLLOVERRIDES="$WINEDLLOVERRIDES;xinput1_1=n,b"
        rm -f "$game/bhhook.log"
    fi
    if [[ "$sound" == off || ( -n "$headless" && "$sound" != on ) ]]; then
        mute
    fi
    if [[ -z "$headless" ]]; then
        wine "$exe" "$@"
        return
    fi
    mkdir -p "$root/run/shots"
    rm -f "$root/run/shots/"*.png
    KEYS="$keys" xvfb-run -a -s "-screen 0 1024x768x24" bash -c '
        # A Wine virtual desktop absorbs the fullscreen mode switch Xvfb cannot do.
        wine explorer /desktop=bionicle,1024x768 "$1" "${@:3}" > "$2/run/game.log" 2>&1 &
        for t in $(seq 1 '"$headless"'); do
            sleep 1
            for k in $KEYS; do
                # Held briefly: the game samples key state once a frame, so an instant
                # press+release can fall between two frames and be missed.
                if [[ "${k%%:*}" == "$t" ]]; then
                    xdotool keydown "${k#*:}"; sleep 0.3; xdotool keyup "${k#*:}"
                fi
            done
            if (( t % 5 == 0 )); then
                xwd -root -silent | magick xwd:- "$2/run/shots/t$(printf %03d "$t").png"
            fi
        done
        wineserver -k
    ' _ "$exe" "$root" "$@"
    ls "$root/run/shots"
}

case "${1:-}" in
    setup) setup ;;
    *) run "$@" ;;
esac
